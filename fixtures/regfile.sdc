create_clock -name clk -period 10.000 [get_ports clk]
set_input_delay  0.400 -clock clk [get_ports rst_n]
set_input_delay  0.400 -clock clk [get_ports we]
set_input_delay  0.400 -clock clk [get_ports waddr]
set_input_delay  0.400 -clock clk [get_ports wdata]
set_input_delay  0.400 -clock clk [get_ports raddr_a]
set_input_delay  0.400 -clock clk [get_ports raddr_b]
set_output_delay 0.400 -clock clk [get_ports rdata_a]
set_output_delay 0.400 -clock clk [get_ports rdata_b]
